{
  "rewrites": [
    { "source": "/pt", "destination": "/index.html" },
    { "source": "/pt/", "destination": "/index.html" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/", "destination": "/index.html" },
    { "source": "/es", "destination": "/index.html" },
    { "source": "/es/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
